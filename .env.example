# Copy to .env (gitignored) and uncomment what you need; load it with
# `uv run --env-file .env domyn-eval ...`, or `export UV_ENV_FILE=$PWD/.env`.
# Leave unused variables commented: an empty value counts as set.
# Variables already set in the shell take precedence. See docs/config.md#environment.

# Key sent to the model and judge endpoints
# API_KEY=

# Where runs are written and `report` reads them (default: runs)
# RUNS_DIR=runs

# Base of the suites' `path` (default: the working directory)
# SUITES_BASE_DIR=

# Hugging Face cache, referenced by the swarm configs as ${HF_HOME}
# HF_HOME=

# domyn-swarm's home directory, where defaults and logs are stored (default: ~/.domyn_swarm)
# DOMYN_SWARM_HOME=

# bfcl: Brave key for the web_search categories
# BRAVE_API_KEY=
# bfcl: local all-MiniLM-L6-v2 for the memory categories on offline nodes
# BFCL_ENCODER_MODEL=

# inspect: Singularity image cache of the code and swe tasks (default: suites/domyn-inspect/.cache/singularity_sif)
# INSPECT_SINGULARITY_SIF_DIR=
# Where `singularity pull` builds those images; the default, the node's $TMPDIR, may be too small for them
# SINGULARITY_TMPDIR=
